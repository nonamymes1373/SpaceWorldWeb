}, new Array(
_mkEl('div', { cssText: 'display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px;' }, new Array(
_mkEl('b', { textContent: m.userName }),
_mkEl('span', { className: 'muted', textContent: dt })
)),
_mkEl('div', { cssText: 'font-size:13px;white-space:pre-wrap;', textContent: m.text })
)));
});
feed.scrollTop = feed.scrollHeight;
};
renderFeed();
var inpMsg = _mkEl('textarea', { rows: '2', placeholder: 'Написать сообщение в заявку...' });
var sendRow = _mkEl('div', { cssText: 'display:flex;gap:8px;margin-top:8px;justify-content:space-between;' }, new Array(
_mkEl('button', { className: 'btn', textContent: 'Закрыть', onclick: function () { closeModal(); renderHrRequestsModule(); } }),
_mkEl('button', {
className: 'btn primary2',
textContent: '📤 Отправить',
onclick: function () {
var txt = (inpMsg.value || '').trim();
if (!txt) return;
var me = current();
var myId = me ? me.id : currentId;
var myName = me ? me.name : 'Сотрудник';
req.messages.push({
id: uid(),
time: new Date().toISOString(),
userId: myId,
userName: myName,
text: txt
});
_saveHrRequests();
inpMsg.value = '';
renderFeed();
var notifyTarget = req.userId === myId ? null : req.userId;

if (notifyTarget) {
addNotification(notifyTarget, '💬 Новое сообщение в вашей заявке («' + meta.label + '»): ' + txt);
}
}
})
));
box.appendChild(feed);
box.appendChild(inpMsg);
box.appendChild(sendRow);
document.getElementById('modal').classList.remove('hidden');
}
/* ── Модалка рассмотрения заявки администратором с авто-применением ── */
function openReviewHrRequestModal(reqId, decision) {
if (!checkBlocked() || !_canManageHrRequests(current())) { toast('❌ Нет прав'); return; }
var req = window.hrRequests.find(function (x) { return x['id'] === reqId; });
if (!req || req.status !== 'pending') return;
var isApprove = decision === 'approved';
var meta = HR_TYPE_META[req.type] || HR_TYPE_META.support;
var box = document.getElementById('modalContent');
box.innerHTML = '';
box.appendChild(_mkEl('h2', { textContent: isApprove ? '✅ Одобрить заявку' : '❌ Отклонить заявку' }));
box.appendChild(_mkEl('p', {
className: 'muted',
cssText: 'margin-bottom:10px;',
textContent: meta.icon + ' ' + meta.label + ' · От: ' + req.userName + ' (' + req.userRole + ')'
}));
var infoLines = new Array(
_mkEl('div', { cssText: 'font-size:13px;', textContent: '💬 Сообщение: ' + req.reason })
);
if (req.dateFrom) infoLines.push(_mkEl('div', { className: 'muted', cssText: 'font-size:12px;margin-top:4px;', textContent: '📅 Срок: с ' + req.dateFrom + ' по ' + req.dateTo + ' (' + req.days + ' дн.)' }));
if (req.targetRole) infoLines.push(_mkEl('div', { className: 'muted', cssText: 'font-size:12px;margin-top:4px;', textContent: '📈 Запрошенная должность: ' + req.targetRole }));
if (req.advanceAmount) infoLines.push(_mkEl('div', { className: 'muted', cssText: 'font-size:12px;margin-top:4px;', textContent: '💰 Запрошенный аванс: ' + fmtBalance(req.advanceAmount) + ' ₽' }));
box.appendChild(_mkEl('div', {
cssText: 'padding:10px 12px;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:8px;margin-bottom:12px;'
}, infoLines));
if (isApprove && req.type !== 'support') {
var autoActionText = {
vacation: '🌴 Сотруднику будет автоматически оформлен отпуск до ' + req.dateTo + '.',
dayoff: '⏳ Сотруднику будет автоматически включён отгул/заморозка до ' + req.dateTo + '.',
promotion: '📈 Должность сотрудника будет автоматически изменена на «' + req.targetRole + '».',
advance: '💰 На баланс сотрудника будет автоматически зачислен аванс +' + fmtBalance(req.advanceAmount) + ' ₽.',
unwarn: '🛡️ С аккаунта сотрудника будет автоматически снят 1 выговор.'
};
box.appendChild(_mkEl('div', {
cssText: 'padding:8px 12px;background:rgba(57,201,130,0.1);border:1px solid rgba(57,201,130,0.35);border-radius:8px;font-size:12px;color:#7ef5b8;margin-bottom:10px;',
textContent: autoActionText[req.type] || ''
}));
}
var inpReply = _mkEl('textarea', {
rows: '2',
placeholder: isApprove ? 'Комментарий к решению (необязательно)...' : 'Укажите причину отклонения заявки...'
});
box.appendChild(_mkField('Ответ сотруднику', inpReply));
box.appendChild(_mkEl('div', { className: 'modal-actions' }, new Array(
_mkEl('button', { className: 'btn', textContent: 'Отмена', onclick: closeModal }),
_mkEl('button', {
className: 'btn ' + (isApprove ? 'primary2' : 'danger'),
textContent: isApprove ? '✅ Подтвердить и применить' : '❌ Отклонить заявку',
onclick: function () {
var reply = (inpReply.value || '').trim();
if (!isApprove && !reply) { toast('❌ Укажите причину отказа'); return; }
req.status = isApprove ? 'approved' : 'rejected';
req.adminReply = reply || (isApprove ? 'Одобрено' : 'Отклонено');
req.processedBy = current().name;
req.processedAt = new Date().toISOString();
        var targetUser = users.find(function (item) { return item['id'] === req.userId; });
        if (isApprove && targetUser) {
          if (req.type === 'vacation') {
            targetUser.onVacation = true;
            targetUser.vacationUntil = req.dateTo;
            targetUser.vacationReason = req.reason;
          } else if (req.type === 'dayoff') {
            targetUser.frozen = true;
            targetUser.frozenUntil = req.dateTo;
            targetUser.frozenReason = 'Отгул: ' + req.reason;
          } else if (req.type === 'promotion' && req.targetRole) {
            targetUser.role = req.targetRole;
          } else if (req.type === 'advance' && req.advanceAmount > 0) {
            changeBalance(req.userId, req.advanceAmount, 'Аванс по кадровой заявке');
            if (Array.isArray(window.payrollRecords)) {
              window.payrollRecords.unshift({
                id: uid(),
                time: new Date().toISOString(),
                userId: req.userId,
                userName: req.userName,
                type: 'Аванс (Кадровый центр)',
                rub: req.advanceAmount,
                coins: 0,
                reason: req.reason,
                byName: current().name
              });

if (typeof _savePayrollData === 'function') _savePayrollData();
}
} else if (req.type === 'unwarn') {
targetUser.warnings = Math.max(0, (Number(targetUser.warnings) || 0) - 1);
}
saveUsers();
}
_saveHrRequests();
addNotification(
req.userId,
(isApprove ? '✅ Ваша заявка одобрена' : '❌ Ваша заявка отклонена') + ' (' + meta.label + ')' + (reply ? ': ' + reply : '')
);
closeModal();
playSound(isApprove ? 'taskDone' : 'click');
toast(isApprove ? '✅ Заявка одобрена и применена!' : '❌ Заявка отклонена');
renderHrRequestsModule();
}
})
)));
document.getElementById('modal').classList.remove('hidden');
}
/* ── Экспорт кадровых заявок в Excel ── */
function exportHrRequestsToExcel() {
if (typeof XLSX === 'undefined') { toast('❌ Библиотека XLSX не загружена'); return; }
var stLabels = { pending: 'Ожидает', approved: 'Одобрено', rejected: 'Отклонено' };
var rows = (window.hrRequests || new Array()).map(function (r) {
var m = HR_TYPE_META[r.type] || HR_TYPE_META.support;
return {
'Дата создания': new Date(r.time).toLocaleString('ru-RU'),
'Сотрудник': r.userName,
'Должность': r.userRole,
'Категория': m.label,
'Срочность': (HR_PRIORITY_META[r.priority] || HR_PRIORITY_META.normal).label,
'Период': r.dateFrom ? (r.dateFrom + ' — ' + r.dateTo) : '—',
'Детали / Сумма / Роль': r.targetRole || (r.advanceAmount ? r.advanceAmount + ' ₽' : '—'),
'Обоснование': r.reason,
'Статус': stLabels[r.status] || r.status,
'Решение': r.adminReply || '—',
'Рассмотрел': r.processedBy || '—'
};
});
var ws = XLSX.utils.json_to_sheet(rows);
var wb = _new();
_append_sheet(wb, ws, 'Заявки');
XLSX.writeFile(wb, 'Kadrovye_Zayavki_' + new Date().toISOString().slice(0, 10) + '.xlsx');
toast('📥 Архив заявок выгружен в Excel');
}
/* ── Главный рендер Кадрового центра (в Сотрудниках и в Админ-панели) ── */
