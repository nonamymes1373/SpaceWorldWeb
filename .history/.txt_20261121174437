var approvedAll = window.hrRequests.filter(function (r) { return r.status === 'approved'; });
var rejectedAll = window.hrRequests.filter(function (r) { return r.status === 'rejected'; });
var myReqs = window.hrRequests.filter(function (r) { return r.userId === currentId; });
// 1. Блок сотрудника в разделе «👥 Сотрудники» (#sectionStaff)
var staffHost = document.getElementById('sectionStaff');
if (staffHost) {
var staffBanner = document.getElementById('staffHrSelfBox');
if (!staffBanner) {
staffBanner = _mkEl('div', {
id: 'staffHrSelfBox',
cssText: 'margin:12px 16px;padding:14px 16px;background:rgba(14,29,22,0.88);border:1px solid var(--line);border-radius:12px;'
});
staffHost.insertBefore(staffBanner, staffHost.firstChild);
}
staffBanner.innerHTML = '';
var quickBtns = new Array(
_mkEl('button', { className: 'btn small primary2', textContent: '🌴 Отпуск', onclick: function () { openCreateHrRequestModal('vacation'); } }),
_mkEl('button', { className: 'btn small', textContent: '⏳ Отгул', onclick: function () { openCreateHrRequestModal('dayoff'); } }),
_mkEl('button', { className: 'btn small', textContent: '📈 Повышение', onclick: function () { openCreateHrRequestModal('promotion'); } }),
_mkEl('button', { className: 'btn small', textContent: '💰 Аванс', onclick: function () { openCreateHrRequestModal('advance'); } }),
_mkEl('button', { className: 'btn small', textContent: '🛡️ Снять выговор', onclick: function () { openCreateHrRequestModal('unwarn'); } }),
_mkEl('button', { className: 'btn small', textContent: '🆘 Поддержка', onclick: function () { openCreateHrRequestModal('support'); } })
);
staffBanner.appendChild(_mkEl('div', {
cssText: 'display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;'
}, new Array(
