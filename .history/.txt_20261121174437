/* ══════════════════════════════════════════════════════════════
   РАСШИРЕННЫЙ КАДРОВЫЙ ЦЕНТР v2.0 (6 категорий + Чат в заявке + Авто-применение + Excel)
   ══════════════════════════════════════════════════════════════ */
window.hrRequests = JSON.parse(localStorage.getItem('hrRequests') || '[]');
window._hrFilterStatus = window._hrFilterStatus || 'all';
window._hrFilterType = window._hrFilterType || '';
window._hrSearchQuery = window._hrSearchQuery || '';
window._pendingHrImg = '';

function _saveHrRequests() {
  try {
    localStorage.setItem('hrRequests', JSON.stringify(window.hrRequests || new Array()));
  } catch (e) { }
}

function _canManageHrRequests(user) {
  if (!user) return false;
  return can(user, 'manage_staff') || can(user, 'manage_permissions') || can(user, 'edit_task');
}

var HR_TYPE_META = {
  vacation:  { icon: '🌴', label: 'Запрос на отпуск', needDates: true, needProof: false },
  dayoff:    { icon: '⏳', label: 'Отгул / Заморозка', needDates: true, needProof: false },
  promotion: { icon: '📈', label: 'Повышение / смена роли', needDates: false, needProof: true },
  advance:   { icon: '💰', label: 'Запрос аванса / выплаты', needDates: false, needProof: false },
  unwarn:    { icon: '🛡️', label: 'Снятие выговора (отработка)', needDates: false, needProof: true },
  support:   { icon: '🆘', label: 'Обращение / Техподдержка', needDates: false, needProof: true }
};

var HR_PRIORITY_META = {
  normal:   { icon: '🟢', label: 'Обычный', weight: 1, border: 'var(--line)' },
  urgent:   { icon: '🟡', label: 'Срочный', weight: 2, border: 'rgba(240,216,120,0.45)' },
  critical: { icon: '🔥', label: 'Критический', weight: 3, border: 'rgba(228,92,109,0.55)' }
};

/* ── Модалка создания заявки сотрудником (6 категорий + приоритет + скриншот) ── */
function openCreateHrRequestModal(defaultType) {
  var user = current();
  if (!user) return;
  window._pendingHrImg = '';

  var rolesList = Array.from(new Set(users.map(function (u) { return u.role; }).filter(Boolean)));
  if (!rolesList.length) rolesList = new Array('Сотрудник', 'Аналитик', 'Куратор', 'Администратор');

  var box = document.getElementById('modalContent');
  box.innerHTML = '';

  box.appendChild(_mkEl('h2', { textContent: '📝 Подать заявку в Кадровый центр' }));
  box.appendChild(_mkEl('p', {
    className: 'muted',
    cssText: 'margin-bottom:12px;',
    textContent: 'Выберите категорию и срочность. Одобренные заявки автоматически применяются к вашему профилю.'
  }));

  var selType = _mkEl('select', null, Object.keys(HR_TYPE_META).map(function (k) {
    var opt = _mkEl('option', { value: k, textContent: HR_TYPE_META[k].icon + ' ' + HR_TYPE_META[k].label });
    if ((defaultType || 'vacation') === k) opt.selected = true;
    return opt;
  }));

  var selPrio = _mkEl('select', null, Object.keys(HR_PRIORITY_META).map(function (k) {
    return _mkEl('option', { value: k, textContent: HR_PRIORITY_META[k].icon + ' ' + HR_PRIORITY_META[k].label });
  }));

  // Блок дат (для отпуска и отгула)
  var todayIso = new Date().toISOString().slice(0, 10);
  var inpDateFrom = _mkEl('input', { type: 'date', value: todayIso });
  var inpDays = _mkEl('input', { type: 'number', min: '1', max: '60', value: '3' });
  var datesBox = _mkEl('div', { className: 'grid' }, new Array(
    _mkField('Дата начала', inpDateFrom),
    _mkField('Длительность (дней)', inpDays)
  ));

  // Блок выбора желаемой роли (для повышения)
  var selTargetRole = _mkEl('select', null, rolesList.map(function (r) {
    var opt = _mkEl('option', { value: r, textContent: r });
    if (r === user.role) opt.selected = true;
    return opt;
  }));
  var promoBox = _mkField('Желаемая должность (текущая: ' + (user.role || 'Сотрудник') + ')', selTargetRole);

  // Блок суммы аванса (для запроса аванса)
  var inpAdvanceRub = _mkEl('input', { type: 'number', min: '100', max: '50000', value: '1000', placeholder: 'Сумма в ₽...' });
  var advanceBox = _mkField('Запрашиваемая сумма аванса (₽)', inpAdvanceRub);

  // Инфо по выговорам (для снятия выговора)
  var warnInfoBox = _mkEl('div', {
    cssText: 'padding:8px 12px;background:rgba(240,216,120,0.08);border:1px solid rgba(240,216,120,0.3);border-radius:8px;font-size:12px;margin-bottom:10px;',
    textContent: '⚠️ Активных выговоров на вашем аккаунте: ' + (Number(user.warnings) || 0) + ' из 3'
  });

  var inpReason = _mkEl('textarea', {
    rows: '3',
    placeholder: 'Подробно опишите причину, ваши достижения, детали отработки или суть вопроса...'
  });

  var prevImg = _mkEl('div', { cssText: 'margin-top:8px;' });
  var fileInp = _mkEl('input', {
    type: 'file',
    accept: 'image/*',
    onchange: async function () {
      var f = Array.from(fileInp.files || new Array()).at(0);
      if (!f) return;
      var dataUrl = typeof _compressTaskImage === 'function' ? await _compressTaskImage(f) : '';
      if (dataUrl) {
        window._pendingHrImg = dataUrl;
        prevImg.innerHTML = '';
        prevImg.appendChild(_mkEl('img', {
          src: dataUrl,
          cssText: 'width:84px;height:84px;object-fit:cover;border-radius:8px;border:1px solid var(--line);cursor:zoom-in;',
          onclick: function () { if (typeof openTaskImageLightbox === 'function') openTaskImageLightbox(dataUrl); }
        }));
      }
    }
  });
  var proofBox = _mkField('📸 Скриншот / подтверждение (необязательно)', _mkEl('div', null, new Array(fileInp, prevImg)));

  var syncFields = function () {
    var k = selType.value;
    var meta = HR_TYPE_META[k] || HR_TYPE_META.support;
    datesBox.style.display = meta.needDates ? 'grid' : 'none';
    promoBox.style.display = k === 'promotion' ? 'block' : 'none';
    advanceBox.style.display = k === 'advance' ? 'block' : 'none';
    warnInfoBox.style.display = k === 'unwarn' ? 'block' : 'none';
    proofBox.style.display = (meta.needProof || k === 'vacation' || k === 'dayoff') ? 'block' : 'none';
  };
  selType.onchange = syncFields;
  syncFields();

  box.appendChild(_mkEl('div', { className: 'grid' }, new Array(
    _mkField('Категория обращения', selType),
    _mkField('Срочность', selPrio)
  )));
  box.appendChild(warnInfoBox);
  box.appendChild(datesBox);
  box.appendChild(promoBox);
  box.appendChild(advanceBox);
  box.appendChild(_mkField('Обоснование / текст обращения', inpReason));
  box.appendChild(proofBox);

  box.appendChild(_mkEl('div', { className: 'modal-actions' }, new Array(
    _mkEl('button', { className: 'btn', textContent: 'Отмена', onclick: closeModal }),
    _mkEl('button', {
      className: 'btn primary2',
      textContent: '📤 Отправить заявку',
      onclick: function () {
        var kind = selType.value;
        var reason = (inpReason.value || '').trim();
        if (!reason) { toast('❌ Заполните обоснование или текст обращения'); return; }
        if (kind === 'unwarn' && (Number(user.warnings) || 0) <= 0) {
          toast('ℹ️ У вас нет активных выговоров для снятия');
          return;
        }
        if (kind === 'promotion' && selTargetRole.value === user.role) {
          toast('ℹ️ Выберите должность, отличную от текущей');
          return;
        }

        var advSum = kind === 'advance' ? Math.max(100, Math.round(Number(inpAdvanceRub.value) || 0)) : 0;
        var dFrom = inpDateFrom.value || todayIso;
        var daysCnt = Math.max(1, Math.min(60, Number(inpDays.value) || 1));
        var endTs = new Date(dFrom + 'T23:59:59').getTime() + (daysCnt - 1) * 86400000;
        var dTo = new Date(endTs).toISOString().slice(0, 10);

        var reqObj = {
          id: uid(),
          time: new Date().toISOString(),
          userId: user.id,
          userName: user.name,
          userRole: user.role || 'Сотрудник',
          type: kind,
          priority: selPrio.value || 'normal',
          dateFrom: HR_TYPE_META[kind].needDates ? dFrom : '',
          dateTo: HR_TYPE_META[kind].needDates ? dTo : '',
          days: HR_TYPE_META[kind].needDates ? daysCnt : 0,
          targetRole: kind === 'promotion' ? selTargetRole.value : '',
          advanceAmount: advSum,
          reason: reason,
          image: window._pendingHrImg || '',
          messages: new Array(),
          status: 'pending',
          adminReply: '',
          processedBy: '',
          processedAt: ''
        };

        window.hrRequests.unshift(reqObj);
        _saveHrRequests();

        (users || new Array()).forEach(function (adm) {
          if (adm.id !== user.id && _canManageHrRequests(adm)) {
            addNotification(adm.id, '📝 Новая заявка (' + HR_TYPE_META[kind].label + ') от ' + user.name);
          }
        });

        closeModal();
        playSound('click');
        toast('✅ Заявка отправлена в Кадровый центр!');
        renderHrRequestsModule();
      }
    })
  )));

  document.getElementById('modal').classList.remove('hidden');
}

/* ── Модальное окно диалога / переписки внутри заявки ── */
function openHrRequestChatModal(reqId) {
  if (!checkBlocked()) return;
  var req = window.hrRequests.find(function (x) { return x.id === reqId; });
  var user = current();
  if (!req || !user) return;
  if (!Array.isArray(req.messages)) req.messages = new Array();

  var meta = HR_TYPE_META[req.type] || HR_TYPE_META.support;
  var box = document.getElementById('modalContent');
  box.innerHTML = '';

  box.appendChild(_mkEl('h2', { textContent: '💬 Обсуждение заявки: ' + meta.label }));
  box.appendChild(_mkEl('p', {
    className: 'muted',
    cssText: 'margin-bottom:10px;',
    textContent: 'Заявитель: ' + req.userName + ' · Суть: ' + req.reason
  }));

  var feed = _mkEl('div', {
    cssText: 'display:flex;flex-direction:column;gap:8px;max-height:240px;overflow-y:auto;padding:10px;background:rgba(0,0,0,0.25);border:1px solid var(--line);border-radius:10px;margin-bottom:10px;'
  });

  var renderFeed = function () {
    feed.innerHTML = '';
    if (!req.messages.length) {
feed.appendChild(_mkEl('div', { className: 'muted', cssText: 'text-align:center;font-size:12px;padding:16px;', textContent: 'Сообщений пока нет. Задайте вопрос или добавьте уточнение.' }));
return;
}
req.messages.forEach(function (m) {
      var isMine = m.userId === user.id;

var dt = new Date(m.time).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
feed.appendChild(_mkEl('div', {
