        if (kind === 'promotion' && selTargetRole.value === me.role) {
          toast('ℹ️ Выберите должность, отличную от текущей');
          return;
        }

        var advSum = kind === 'advance' ? Math.max(100, Math.round(Number(inpAdvanceRub.value) || 0)) : 0;
        var dFrom = inpDateFrom.value || todayIso;
        var daysCnt = Math.max(1, Math.min(60, Number(inpDays.value) || 1));
        var endTs = new Date(dFrom + 'T23:59:59').getTime() + (daysCnt - 1) * 86400000;
        var dTo = new Date(endTs).toISOString().slice(0, 10);

        var reqObj = {
          id: uid(),
          time: new Date().toISOString(),
          userId: me['id'],
          userName: me['name'],
          userRole: me['role'] || 'Сотрудник',
          type: kind,
          priority: selPrio.value || 'normal',
          dateFrom: HR_TYPE_META[kind].needDates ? dFrom : '',
          dateTo: HR_TYPE_META[kind].needDates ? dTo : '',
          days: HR_TYPE_META[kind].needDates ? daysCnt : 0,
          targetRole: kind === 'promotion' ? selTargetRole.value : '',
          advanceAmount: advSum,
          reason: reason,
          image: window._pendingHrImg || '',
          messages: new Array(),
          status: 'pending',
          adminReply: '',
          processedBy: '',
          processedAt: ''
        };

        window.hrRequests.unshift(reqObj);
        window._hrCabinetTab = 'tickets';
        _saveHrRequests();

        (users || new Array()).forEach(function (adm) {
          if (adm['id'] !== me['id'] && _canManageHrRequests(adm)) {
            addNotification(adm['id'], '📝 Новое обращение (' + HR_TYPE_META[kind].label + ') от ' + me['name']);
          }
        });

        closeModal();
        playSound('click');
        toast('✅ Обращение отправлено! Отслеживайте статус в личном кабинете.');
        renderHrRequestsModule();
      }
    })
  )));

  document.getElementById('modal').classList.remove('hidden');
}

