async function handleTaskReportFiles(input) {
  var files = [...(input.files || [])].slice(0, 3);
  if (!files.length) return;
  toast('⏳ Сжимаем скриншоты...');
  for (var i = 0; i < files.length; i++) {
    if (window._pendingTaskReportImgs.length >= 3) break;
    var dataUrl = await _compressTaskImage(files[i]);
    if (dataUrl) window._pendingTaskReportImgs.push(dataUrl);
  }
  _renderPendingReportPreview();
}

function _renderPendingReportPreview() {
  var box = document.getElementById('taskReportImgPreview');
  if (!box) return;
  box.innerHTML = window._pendingTaskReportImgs.map(function (src, idx) {
    return '<div style="position:relative;width:68px;height:68px;border-radius:8px;overflow:hidden;border:1px solid var(--line);">' +
      '<img src="' + src + '" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;" onclick="openTaskImageLightbox(\'' + src + '\')">' +
      '<button type="button" onclick="window._pendingTaskReportImgs.splice(' + idx + ',1);_renderPendingReportPreview();" ' +
      'style="position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,0.75);color:#fff;border:none;cursor:pointer;font-size:11px;line-height:1;">×</button>' +
    '</div>';
  }).join('');
}

