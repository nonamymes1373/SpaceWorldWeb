function submitTaskForReview(taskId) {
  var t = tasks.find(function (x) { return x.id === taskId; });
  if (!t) return;
  var report = (document.getElementById('taskReportInput').value || '').trim();
  var imgs = window._pendingTaskReportImgs.slice(0, 3);
  if (!report && !imgs.length) { toast('❌ Напишите отчёт или прикрепите скриншот'); return; }

  t.report = report || 'Прикреплены скриншоты (' + imgs.length + ' шт.)';
  t.reportImages = imgs;
  t.reviewNote = '';
  t.status = 'review';
  t.submittedAt = new Date().toISOString();

  logTaskEvent(t, '📤', 'Отправлено на проверку' + (imgs.length ? ' (скриншотов: ' + imgs.length + ')' : '') + '. Отчёт: ' + t.report);
  saveTasks();
  closeModal();
  playSound('click');
  toast('🟣 Задача отправлена на проверку!');
  if (t.createdBy && t.createdBy !== current().id) {
    addNotification(t.createdBy, '🟣 На проверку сдана задача: ' + t.title);
  }
  renderTasks();
}

function approveTaskReview(taskId) {
  if (!checkBlocked()) return;
  var t = tasks.find(function (x) { return x.id === taskId; });
  if (!t) return;
  var user = current();
  if (!can(user, 'edit_task') && t.createdBy !== user.id) { toast('❌ Только руководитель или автор может принять задачу'); return; }

  t.status = 'done';
  t.completedAt = new Date().toISOString();

  var memberIds = _getTaskAssignees(t);
  var countMembers = Math.max(1, memberIds.length);
  var splitReward = (t.rewardMode === 'split' && countMembers > 1);

  var totalCoins = Number(t.rewardCoins) || 0;
  var totalBal = Number(t.rewardBalance) || 0;
  var perCoins = splitReward ? Math.floor(totalCoins / countMembers) : totalCoins;
  var perBal = splitReward ? Math.floor(totalBal / countMembers) : totalBal;

  var onTime = !t.deadline || (new Date(t.deadline + 'T23:59:59').getTime() >= Date.now());
  var penaltyCoins = !onTime ? (Number(t.latePenaltyCoins) || 0) : 0;
  var xpMap = { 'низкий': 50, 'средний': 100, 'высокий': 200 };
  var xpGain = xpMap[t.priority] || 100;

  var paidNames = [];
  memberIds.forEach(function (uid) {
    var au = users.find(function (u) { return u.id === uid; });
    if (!au) return;
    paidNames.push(au.name);

    var netCoins = Math.max(0, perCoins - penaltyCoins);
    if (netCoins > 0) changeCoins(au.id, netCoins, 'Задача: ' + t.title + (splitReward ? ' (доля 1/' + countMembers + ')' : ''));
    if (perBal > 0) changeBalance(au.id, perBal, 'Задача: ' + t.title + (splitReward ? ' (доля 1/' + countMembers + ')' : ''));
    if (trustSettings.enabled) {
      changeTrust(au.id, onTime ? trustSettings.weights.taskOnTime : -2, onTime ? 'Задача выполнена в срок' : 'Просрочка задачи');
    }
    if (typeof addBattlePassXp === 'function') {
      try { addBattlePassXp(au.id, xpGain, 'Задача: ' + t.title); } catch (_) { }
    }
    var rParts = [];
    if (netCoins > 0) rParts.push(netCoins + ' 🪙');
    if (perBal > 0) rParts.push(perBal + ' ₽');
    addNotification(au.id, '✅ Задача принята: ' + t.title + (rParts.length ? ' · Награда: ' + rParts.join(' + ') : ''));
  });

  var summaryParts = [];
  if (perCoins > 0) summaryParts.push(perCoins + ' 🪙' + (splitReward ? '/чел' : ''));
  if (perBal > 0) summaryParts.push(perBal + ' ₽' + (splitReward ? '/чел' : ''));

  logTaskEvent(t, '✅', 'Принято (' + (paidNames.join(', ') || 'без исполнителей') + ')' + (summaryParts.length ? '. Начислено: ' + summaryParts.join(' + ') : ''));
  saveTasks();
  saveUsers();
  playSound('taskDone');
  toast('✅ Задача принята' + (summaryParts.length ? '! Выплачено: ' + summaryParts.join(' + ') : '!'));
  try { _bpRefreshIfVisible(); } catch (_) { }
  renderTasks();
}

function rejectTaskReview(taskId) {
  if (!checkBlocked()) return;
  var t = tasks.find(function (x) { return x.id === taskId; });
  if (!t) return;
  var reason = prompt('Укажите причину возврата на доработку:');
  if (reason === null) return;
  t.status = 'in_progress';
  t.reviewNote = reason.trim() || 'Требуется доработка';
  logTaskEvent(t, '↩', 'Возвращено на доработку: ' + t.reviewNote);
  saveTasks();
  _getTaskAssignees(t).forEach(function (uid) {
    addNotification(uid, '↩ Задача возвращена на доработку: ' + t.title + ' (' + t.reviewNote + ')');
  });
  playSound('click');
  toast('↩ Возвращено на доработку');
  renderTasks();
}

