/* ── Автоматическое сжатие скриншотов перед сохранением в SQLite ── */
function _compressTaskImage(file) {
  return new Promise(function (resolve) {
    if (!file || !file.type || file.type.indexOf('image/') !== 0) return resolve(null);
    var reader = new FileReader();
    reader.onload = function (e) {
      var img = new Image();
      img.onload = function () {
        var maxSide = 1100;
        var w = img.width, h = img.height;
        if (w > maxSide || h > maxSide) {
          if (w > h) { h = Math.round(h * maxSide / w); w = maxSide; }
          else { w = Math.round(w * maxSide / h); h = maxSide; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', 0.78));
      };
      img.onerror = function () { resolve(null); };
      img.src = e.target.result;
    };
    reader.onerror = function () { resolve(null); };
    reader.readAsDataURL(file);
  });
}

function openTaskImageLightbox(src) {
  if (!src) return;
  var lb = document.getElementById('taskImgLightbox');
  if (!lb) {
    lb = document.createElement('div');
    lb.id = 'taskImgLightbox';
    lb.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:20000;display:flex;align-items:center;justify-content:center;padding:20px;cursor:zoom-out;';
    lb.onclick = function () { lb.style.display = 'none'; };
    document.body.appendChild(lb);
  }
  lb.innerHTML = '<img src="' + src + '" style="max-width:95vw;max-height:92vh;border-radius:10px;box-shadow:0 10px 40px rgba(0,0,0,0.8);">';
  lb.style.display = 'flex';
}

/* ── Хронология событий внутри каждой задачи ── */
function logTaskEvent(task, icon, text) {
  if (!task) return;
  if (!Array.isArray(task.history)) task.history = [];
  var u = current();
  task.history.unshift({
    time: new Date().toISOString(),
    by: u ? u.name : 'Система',
    icon: icon || '📋',
    text: text
  });
  if (task.history.length > 100) task.history.length = 100;
}

function openTaskHistoryModal(taskId) {
  var t = tasks.find(function (x) { return x.id === taskId; });
  if (!t) return;
  var list = Array.isArray(t.history) ? t.history : [];
  var rowsHtml = list.length
    ? list.map(function (h) {
        var dt = new Date(h.time).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        return '<div style="display:flex;gap:10px;align-items:flex-start;padding:8px 10px;background:rgba(255,255,255,0.03);border:1px solid var(--line);border-radius:8px;">' +
          '<div style="font-size:16px;">' + esc(h.icon || '📋') + '</div>' +
          '<div style="flex:1;min-width:0;">' +
            '<div style="font-size:13px;">' + esc(h.text) + '</div>' +
