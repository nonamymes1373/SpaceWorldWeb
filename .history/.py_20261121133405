function _renderSingleTaskCard(t, user) {
  var memberIds = _getTaskAssignees(t);
  var isOwn = memberIds.indexOf(user.id) !== -1;
  var maxSlots = Math.max(1, Number(t.maxAssignees) || 1);
  var isFree = memberIds.length < maxSlots;
  var canApprove = can(user, 'edit_task') || t.createdBy === user.id;
  var cE = can(user, 'edit_task') && (can(user, 'view_all_tasks') || isOwn);
  var cD = can(user, 'delete_task') && (can(user, 'view_all_tasks') || isOwn);

  var statusMap = {
    open: { label: isFree ? (maxSlots > 1 ? '👥 Набор (' + memberIds.length + '/' + maxSlots + ')' : '🌐 Биржа') : '🔵 Открыта', cls: 'open' },
    in_progress: { label: (isFree && maxSlots > 1) ? ('🟡 В работе (' + memberIds.length + '/' + maxSlots + ')') : '🟡 В работе', cls: 'in_progress' },
    review: { label: '🟣 На проверке', cls: 'review' },
