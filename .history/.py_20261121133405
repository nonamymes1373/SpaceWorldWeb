    '<div class="modal-actions"><button class="btn primary2" onclick="closeModal()">Закрыть</button></div>';
  document.getElementById('modal').classList.remove('hidden');
}

/* ── Хелперы командных задач (бригад) ── */
function _getTaskAssignees(t) {
  if (Array.isArray(t.assignees) && t.assignees.length) return t.assignees.slice();
  return t.assignee ? [t.assignee] : [];
}

function _isUserInTask(t, userId) {
  return _getTaskAssignees(t).indexOf(userId) !== -1;
}

function toggleTaskViewMode() {
  window._taskViewMode = (window._taskViewMode === 'kanban') ? 'grid' : 'kanban';
  localStorage.setItem('taskViewMode', window._taskViewMode);
  renderTasks();
}

function setTaskQuickTab(tab) {
  window._taskQuickTab = tab || 'all';
  renderTasks();
}

function _formatTaskTimeLeft(deadlineStr, status) {
  if (!deadlineStr) return '';
  if (status === 'done') return '<span class="chip deadline">📅 ' + esc(fmtDate(deadlineStr)) + '</span>';
  var end = new Date(deadlineStr + 'T23:59:59').getTime();
  var diff = end - Date.now();
  if (diff < 0) {
    var daysLate = Math.max(1, Math.ceil(Math.abs(diff) / 86400000));
    return '<span class="chip deadline overdue">🔥 Просрочено (' + daysLate + ' дн)</span>';
  }
  var hoursLeft = Math.floor(diff / 3600000);
  if (hoursLeft < 24) return '<span class="chip deadline" style="border-color:#e5c35c;color:#e5c35c;">⏳ Осталось ' + Math.max(1, hoursLeft) + ' ч</span>';
  var daysLeft = Math.ceil(diff / 86400000);
  return '<span class="chip deadline">📅 ' + esc(fmtDate(deadlineStr)) + ' (' + daysLeft + ' дн)</span>';
}

function toggleTaskChecklistItem(taskId, itemIdx) {
  if (!checkBlocked()) return;
  var t = tasks.find(function (x) { return x.id === taskId; });
  if (!t || !Array.isArray(t.checklist) || !t.checklist[itemIdx]) return;
  var user = current();
  if (!can(user, 'edit_task') && !_isUserInTask(t, user.id)) { toast('❌ Нет прав'); return; }
  t.checklist[itemIdx].done = !t.checklist[itemIdx].done;
  var clItem = t.checklist[itemIdx];
  logTaskEvent(t, clItem.done ? '☑️' : '⬜', (clItem.done ? 'Выполнен пункт: «' : 'Снята отметка: «') + clItem.text + '»');
  saveTasks();
  playSound('click');
  renderTasks();
}

function claimOpenTask(taskId) {
  if (!checkBlocked()) return;
  var t = tasks.find(function (x) { return x.id === taskId; });
  var user = current();
  if (!t || !user) return;
  var maxSlots = Math.max(1, Number(t.maxAssignees) || 1);
  var currentList = _getTaskAssignees(t);

  if (currentList.indexOf(user.id) !== -1) { toast('ℹ️ Вы уже участвуете в этой задаче'); return; }
  if (currentList.length >= maxSlots) { toast('❌ Все места в команде уже заняты'); return; }

  var reqTrust = Number(t.minTrust) || 0;
  if (reqTrust > 0 && getEffectiveTrust(user) < reqTrust) {
    toast('❌ Нужен trust от ' + reqTrust + ' (у вас ' + getEffectiveTrust(user) + ')', 'error');
    return;
  }
  if (t.reqRole && user.role !== t.reqRole && !can(user, 'view_all_tasks')) {
    toast('❌ Задача только для роли: ' + t.reqRole, 'warn');
    return;
  }

  var _activeT = tasks.filter(function (x) { return _isUserInTask(x, user.id) && x.status !== 'done'; }).length;
  if (_activeT >= getLimit('task', 'maxActivePerUser')) { toast('❌ Достигнут лимит активных задач'); return; }

  currentList.push(user.id);
  t.assignees = currentList;
  t.assignee = currentList;
  t.assigneeName = currentList.map(function (uid) {
    var uObj = users.find(function (u) { return u.id === uid; });
    return uObj ? uObj.name : '';
  }).filter(Boolean).join(', ');
  t.status = 'in_progress';
  t.takenAt = new Date().toISOString();

  logTaskEvent(t, maxSlots > 1 ? '👥' : '✋', maxSlots > 1 ? ('Вступил в команду (' + currentList.length + '/' + maxSlots + ')') : 'Взял задачу с биржи в работу');
  saveTasks();
  playSound('click');
  toast(maxSlots > 1 ? '👥 Вы присоединились к команде!' : '✋ Вы взяли задачу в работу!');
  renderTasks();
}

function abandonTask(taskId) {
  if (!checkBlocked()) return;
  var t = tasks.find(function (x) { return x.id === taskId; });
  var user = current();
  if (!t || !user || !_isUserInTask(t, user.id)) return;
  if (!confirm('Отказаться от задачи и освободить место на бирже?')) return;

  var currentList = _getTaskAssignees(t).filter(function (id) { return id !== user.id; });
  t.assignees = currentList;
  t.assignee = currentList || '';
  t.assigneeName = currentList.map(function (uid) {
    var uObj = users.find(function (u) { return u.id === uid; });
    return uObj ? uObj.name : '';
  }).filter(Boolean).join(', ');

  if (!currentList.length) t.status = 'open';
  t.reviewNote = '';
  logTaskEvent(t, '🏳', 'Отказался от выполнения и вернул место на биржу');
  saveTasks();
  playSound('click');
  toast('🏳 Вы вышли из задачи');
  renderTasks();
}
